# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real API keys.

# Google Gemini API key
# Get yours free at: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_gemini_api_key_here

# Kaggle (for dataset downloads) authenticates via ~/.kaggle/kaggle.json, not via .env.
# Create a token at kaggle.com > Settings > API > Create New Token, move the downloaded
# kaggle.json to ~/.kaggle/kaggle.json, then run: chmod 600 ~/.kaggle/kaggle.json
# See scripts/download_data.py for details.

# Qdrant vector database
# When running locally via Docker, these are the defaults
QDRANT_HOST=localhost
QDRANT_PORT=6333

# MLflow tracking
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
MLFLOW_EXPERIMENT_NAME=grocery-iq
