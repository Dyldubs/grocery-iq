# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real API keys.

# Google Gemini API key
# Get yours free at: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_gemini_api_key_here

# Kaggle credentials (for dataset downloads)
# Download kaggle.json from kaggle.com → Account → API
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_key

# Qdrant vector database
# When running locally via Docker, these are the defaults
QDRANT_HOST=localhost
QDRANT_PORT=6333

# MLflow tracking
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
MLFLOW_EXPERIMENT_NAME=grocery-iq
